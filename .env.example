# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Vite) environment — BUILD-TIME variables.
#
# Usage:
#   cp .env.example .env      # then edit values
#   npm run build             # VITE_* vars are baked into the bundle HERE
#
# IMPORTANT: these are read at BUILD time, not run time. After changing any value
# you MUST rebuild the frontend; restarting the server alone has no effect.
# Only variables prefixed with VITE_ are exposed to the browser.
# (Backend/server variables live in server/.env — keep them separate.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Hotmart checkout ─────────────────────────────────────────────────────────
# Product HotLink code (ALPHANUMERIC, e.g. L105904578M) — NOT the numeric id 7769917.
# Find it in any offer's link:  https://pay.hotmart.com/<THIS>?off=w32kp5a7
VITE_HOTMART_PRODUCT_CODE=L105904578M

# Offer codes (OPTIONAL — these already match the built-in defaults in
# src/config/hotmart.ts). Only override if you change the offers in Hotmart.
VITE_HOTMART_OFFER_BASICO=w32kp5a7
VITE_HOTMART_OFFER_INTERMEDIO=d67r8at1
VITE_HOTMART_OFFER_PREMIUM=8wk6nu6z
