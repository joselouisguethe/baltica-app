DATABASE_URL=postgresql://user:password@localhost:5432/baltica
JWT_SECRET=change-this-to-a-secure-random-string
PORT=3001
MERCADOPAGO_ACCESS_TOKEN=TEST-your-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-mercadopago-secret
FRONTEND_URL=http://localhost:8080
# Public URL of THIS server. Must be a public https URL in production (or an
# ngrok tunnel locally) for MercadoPago to deliver webhooks. While left as
# localhost, notification_url is omitted and webhooks will not fire.
BACKEND_URL=http://localhost:3001
# Hotmart webhook authentication token (Hotmart dashboard → Tools → Webhook/Postback)
HOTMART_HOTTOK=
# Optional: Hotmart REST API credentials (for sales reconciliation)
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
ADMIN_EMAIL=admin@baltica.app
ADMIN_PASSWORD=change-this-admin-password
